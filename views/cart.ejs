<%- include('./partials/header') %>
    <div class="w-full h-screen flex flex-wrap items-center justify-center px-20 py-20 gap-10">
        
        <% if(user.cart.length>0){ %>
            <% user.cart.forEach((product)=>{ %>
                <div class="w-full h-fit flex items-start px-20 py-20 gap-10">
                    <div class="w-[30%] rounded-xl overflow-hidden flex flex-col justify-center items-center bg-[<%= product.bgcolor %>]">
                        <img class="w-full h-[40%]" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="products"></img>
                        <div class="w-full flex justify-between bg-[<%=product.panelcolor %>] px-5 py-4">
                            <h3 class="text-lg rounded-xl"><%= product.name %></h3>
                            <div class="flex items-center gap-2">
                                <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"></i>
                                <div class="px-2 py-1 rounded-xl bg-white text-black">01</div>
                                <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
                            </div>
                        </div>
                        <div class="w-full flex items-center bg-[<%= product.textcolor %>] justify-between  px-5 py-3">
                            <h4 class="text-lg">Net Total:</h4>
                            <h2 class="text-lg">₹<%= 20 + (100-Number(product.discount))*product.price/100 %></h2>
                        </div>
                    </div>
                    <div class="w-[70%] h-[400px]">
                        <h3 class="text-xl">Price Breakdown</h3>
                        <div class="px-10 mt-5">
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Total MRP</h4>
                                <h4>₹<%= product.price %></h4>
                            </div>
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Discount on MRP</h4>
                                <h4><%= Number(product.discount)%> %</h4>
                            </div>
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Platform Fee</h4>
                                <h4>₹ 20</h4>
                            </div>
                            <div class="flex mt-2">
                                <h4 class="w-1/3">Shipping Fee</h4>
                                <h4>FREE</h4>
                            </div>
                        </div>
                        <div class="w-full h-[1px] bg-black mt-10"></div>
                        <div class="flex mt-5">
                            <h3 class="w-1/3 text-xl">Total Amount</h3>
                            <h3 class="font-semibold text-xl text-green-600">₹<%= 20 + (100-Number(product.discount))*product.price/100  %></h3>
                        </div>
                        <form action=""></form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div>
                <h1 class="text-center text-2xl font-bold font-sans">Cart is empty</h1>
            </div>
        <% } %>
       
    </div>
    <%- include('./partials/footer') %>